{
  "name": "pinto",
  "version": "0.1.0",
  "private": true,
  "description": "Pinto \u2014 bulk pricing for Google Play. Bulk pricing, without the bulk work.",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "npm run clean && npm run icons && npm run build:ui && npm run build:content && node scripts/finalize.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "presets": "node scripts/make-tier-preset.mjs && node scripts/make-iptv-presets.mjs",
    "build:ui": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/chrome": "^0.0.301",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
